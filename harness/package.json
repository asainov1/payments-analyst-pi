{
  "name": "harness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "node --env-file=../.env --test test/live/*.test.ts",
    "lint": "biome check src test && tsc --noEmit",
    "harness": "node src/cli/harness.ts",
    "test:docker": "node --test test/docker/*.test.ts",
    "serve": "node --env-file=../.env src/server/main.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@langfuse/otel": "6.0.2",
    "@langfuse/tracing": "6.0.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "diff": "8.0.4",
    "fastify": "5.12.8",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
