# LiteLLM (provided by the organisers)
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Global budget cap for our runs (USD). The key has $150; $15 stays reserved for the holdout run.
GLOBAL_BUDGET_USD=135

# Self-hosted Langfuse (docker compose). These defaults create the project on first start.
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_PROJECT_ID=analyst
# UI login: admin@local.test / admin12345 (override with LANGFUSE_USER_EMAIL / LANGFUSE_USER_PASSWORD)
